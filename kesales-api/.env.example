APP_NAME=KESALES
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Nairobi
APP_URL=https://api.kesales.ke

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database (PostgreSQL 16+)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kesales_db
DB_USERNAME=kesales_app
DB_PASSWORD=

# Cache, Queue, and Session (Redis 7+)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.kesales.ke

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Laravel Sanctum (Stateful SPA for Next.js)
SANCTUM_STATEFUL_DOMAINS=kesales.ke,www.kesales.ke,localhost:3000

# Safaricom Daraja M-Pesa Credentials
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379
MPESA_STK_CALLBACK_URL=https://api.kesales.ke/webhooks/mpesa/stk
MPESA_C2B_VALIDATION_URL=https://api.kesales.ke/webhooks/mpesa/c2b-validation
MPESA_C2B_CONFIRMATION_URL=https://api.kesales.ke/webhooks/mpesa/c2b-confirmation

# M-Pesa B2C (Seller Payouts & Customer Refunds)
MPESA_B2C_SHORTCODE=
MPESA_B2C_INITIATOR_NAME=
MPESA_B2C_SECURITY_CREDENTIAL=
MPESA_B2C_RESULT_URL=https://api.kesales.ke/webhooks/mpesa/b2c-result
MPESA_B2C_TIMEOUT_URL=https://api.kesales.ke/webhooks/mpesa/b2c-timeout

# KRA eTIMS System-to-System Invoicing
ETIMS_ENV=sandbox
ETIMS_BASE_URL=https://etims-api.kra.go.ke
ETIMS_TIN_PIN=
ETIMS_BRANCH_ID=00
ETIMS_DEVICE_ID=
ETIMS_AUTH_KEY=
ETIMS_INVOICE_ISSUER_TYPE=platform

# Mail Configuration
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@kesales.ke"
MAIL_FROM_NAME="${APP_NAME}"

# SMS Gateway (Africa's Talking / Infobip)
SMS_PROVIDER=africastalking
AFRICASTALKING_USERNAME=kesales
AFRICASTALKING_API_KEY=
SMS_SENDER_ID=KESALES

# WhatsApp Cloud API Provider
WHATSAPP_PROVIDER=meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Object Storage / CDN (AWS S3 or Cloudflare R2)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=kesales-media
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=
AWS_URL=https://cdn.kesales.ke
