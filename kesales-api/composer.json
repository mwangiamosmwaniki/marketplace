{
  "name": "kesales/kesales-api",
  "type": "project",
  "description": "KESALES Multi-Vendor Marketplace Laravel 13 API Backend",
  "keywords": [
    "laravel",
    "marketplace",
    "e-commerce",
    "mpesa",
    "etims",
    "daraja",
    "kenya"
  ],
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "guzzlehttp/guzzle": "^7.8",
    "laravel/framework": "^13.0",
    "laravel/horizon": "^5.24",
    "laravel/sanctum": "^4.0",
    "laravel/tinker": "^3.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.9",
    "pestphp/pest": "^5.0",
    "pestphp/pest-plugin-laravel": "^5.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
